# Twitch Developer App
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch-Kanal
BROADCASTER_USER_ID=
BROADCASTER_LOGIN=

# Account, der im Chat als Bot schreibt
BOT_USER_ID=
BOT_LOGIN=
BOT_ACCESS_TOKEN=
BOT_REFRESH_TOKEN=

# Token des Kanalinhabers für Kanalpunkte
# Benötigt mindestens channel:read:redemptions.
BROADCASTER_ACCESS_TOKEN=
BROADCASTER_REFRESH_TOKEN=

# Overlay bleibt intern; später wird Nginx davor gesetzt.
OVERLAY_HOST=127.0.0.1
OVERLAY_PORT=3010
TWITCH_EXTENSION_SECRET=BASE64_SECRET_AUS_DER_TWITCH_CONSOLE
TWITCH_EXTENSION_CHANNEL_ID=DEINE_NUMERISCHE_TWITCH_KANAL_ID
# Geheimer Schlüssel für den lokalen Widget-Entwicklungsserver.
# Auf PC und Hetzner muss derselbe zufällige Wert mit mindestens 32 Zeichen stehen.
WIDGET_DEV_KEY=

# Nur auf dem Entwicklungs-PC benötigt:
DEV_TWITCH_USER_ID=
WIDGET_DEV_API_URL=https://overlay.schiggygang.de
WIDGET_DEV_PORT=8080

# 0 = automatische Spawns zunächst deaktiviert.
# Den korrekten bisherigen Intervall tragen wir nach der Streamer.bot-Analyse ein.
AUTO_SPAWN_INTERVAL_MINUTES=0
AUTO_SPAWN_ONLY_WHEN_LIVE=true
SPAWN_RESOLVE_GRACE_SECONDS=5
RAID_RESOLVE_GRACE_SECONDS=2

# Twitch-Nachrichten
CHAT_MESSAGE_MAX_LENGTH=480
CHAT_SEND_DELAY_MS=1100

# Optional: Titel von Kanalpunkte-Belohnungen überschreiben.
# Format: JSON-Objekt Titel -> Item-ID
# Erlaubte Item-IDs: fire_stone, water_stone, thunder_stone,
# leaf_stone, moon_stone, xp_candy_s, xp_candy_m, xp_candy_l
# REWARD_ITEM_MAP_JSON={"Blattstein":"leaf_stone"}

# Website-Synchronisierung über FTPS
WEB_SYNC_HOST=w01f6646.kasserver.com
WEB_SYNC_USERNAME=
WEB_SYNC_PASSWORD=
WEB_SYNC_REMOTE_DIR=/schiggygang.de/JSON
WEB_SYNC_INTERVAL_SECONDS=5
# WEB_SYNC_FILES=pokedex.json,profiles.json,spawn.json,resolveMessage.txt,spawnMessage.txt,catchMessage.txt

# Optional: abweichender Datenordner
# POKEDEX_DATA_DIR=/opt/pokedex/data
